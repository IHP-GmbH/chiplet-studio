# OpenROAD 3Dblox interop demo
# A small assembly whose flow: block exports the file to 3Dblox
# (.3dbv/.3dbx) and lints the result with OpenROAD's check_3dblox.
# See README.md in this directory for prerequisites.

format_version: "1.0"

assembly:
  name: "openroad_3dblox_demo"
  description: "Flow demo: export to 3Dblox and lint with check_3dblox"
  units: "um"

technologies:
  demo_interposer:
    description: "Demo interposer technology"
    dbu: 0.001
  demo_die:
    description: "Demo die technology"
    dbu: 0.001

connection_stacks:
  cupillar_opt1:
    description: "Cu pillar, Table 6.1 Option 1 (35um opening)"
    layers:
      - name: CuPillar
        material: Cu
        height: 28.0
        diameter: 44.0
      - name: SnAgCap
        material: SnAg
        height: 16.0
        diameter: 44.0

components:
  - id: interposer
    type: interposer
    technology: demo_interposer
    anchor: bbox_center
    top_cell: DEMO_INTERPOSER
    dimensions:
      width: 1000.0
      height: 800.0
      thickness: 10.0
    position:
      x: 500.0
      y: 400.0
      z: 0.0

  - id: D1
    type: die
    technology: demo_die
    anchor: gds_origin
    top_cell: DIE_A
    connection: cupillar_opt1
    orientation: flip_chip
    dimensions:
      width: 300.0
      height: 200.0
      thickness: 150.0
    position:
      x: 250.0
      y: 300.0
      z: 54.0   # mount surface (10) + cupillar_opt1 stack height (44)
    rotation:
      z: 0.0

  - id: D2
    type: die
    technology: demo_die
    anchor: gds_origin
    top_cell: DIE_B
    connection: cupillar_opt1
    orientation: flip_chip
    dimensions:
      width: 200.0
      height: 200.0
      thickness: 100.0
    position:
      x: 700.0
      y: 300.0
      z: 54.0
    rotation:
      z: 0.0

flow:
  steps:
    - id: export_3dblox
      name: "Export to 3Dblox"
      tool: python3
      script: ../../../adk/openroad/chiplet2dbx.py
      args:
        - --chiplet
        - openroad_3dblox_demo.chiplet
        - --out-dir
        - build_3dblox
      output_files:
        - build_3dblox/openroad_3dblox_demo.3dbx

    - id: check_3dblox
      name: "OpenROAD check_3dblox"
      tool: /bin/bash
      script: run_check_3dblox.sh
      args:
        - build_3dblox
        - openroad_3dblox_demo
      depends_on: [export_3dblox]
      input_files:
        - build_3dblox/openroad_3dblox_demo.3dbx
