# Dockerfile.build - Build environment for Chiplet Studio
#
# Contains all dependencies to compile KLayout and Chiplet Studio

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Base build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Qt6 development packages
RUN apt-get update && apt-get install -y \
    qt6-base-dev \
    qt6-base-dev-tools \
    libqt6opengl6-dev \
    libqt6openglwidgets6 \
    libqt6core5compat6-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

# Create qmake symlink for KLayout build (Qt6 names it qmake6)
# Use -sf to force overwrite if qtchooser created a different symlink
RUN ln -sf /usr/bin/qmake6 /usr/bin/qmake

# KLayout build dependencies
RUN apt-get update && apt-get install -y \
    ruby \
    ruby-dev \
    python3 \
    python3-dev \
    libz-dev \
    libcurl4-openssl-dev \
    libgit2-dev \
    && rm -rf /var/lib/apt/lists/*

# yaml-cpp for .chiplet format parsing
RUN apt-get update && apt-get install -y \
    libyaml-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

# Cross-reader check dependency (TEST ONLY).
#
# A .chiplet written here is read by PyYAML downstream (the KiCad plugin,
# chiplet-system-spec's reference reader, interposer-pnr), and PyYAML resolves
# scalars per YAML 1.1 where yaml-cpp does not. tests/cross_reader_check.py
# drives this studio's real writer output through PyYAML so the two readers are
# compared by measurement instead of by argument.
#
# It lives in its own venv, never in the system interpreter, and it is NOT a
# Studio runtime dependency: nothing in Dockerfile.runtime installs it and no
# Studio code imports yaml. The version is pinned because the pin names the
# reader whose 1.1 resolution the expectations assert; interposer-pnr is the
# only exact pin in the ecosystem and it is 6.0.3. chiplet-system-spec's
# reference reader declares PyYAML>=5.1, so this tests one point in a wider
# declared range.
RUN apt-get update && apt-get install -y \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/crossreader-venv \
    && /opt/crossreader-venv/bin/pip install --no-cache-dir "PyYAML==6.0.3" \
    && /opt/crossreader-venv/bin/python -c "import yaml; assert yaml.__version__ == '6.0.3', yaml.__version__"

# X11 virtual framebuffer for headless GUI testing
RUN apt-get update && apt-get install -y \
    xvfb \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    && rm -rf /var/lib/apt/lists/*

# Debugging tools (gdb, valgrind, strace)
RUN apt-get update && apt-get install -y \
    gdb \
    gdbserver \
    valgrind \
    strace \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for builds
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} builder && \
    useradd -u ${UID} -g ${GID} -m builder

# PDK roots at FIXED container paths so the image carries no host-specific
# paths and runs on any host (the run-*.sh launchers mount each host PDK dir
# onto the matching path here; see scripts/pdk-env.sh). The resolution chain is
# env -> textvar -> sibling walk, so these are the authoritative source: e.g.
# chiplet-studio's interconnect stackup-fragment lookup reads
# INTERCONNECT_PDK_ROOT first, which is what makes CuPillar/bump bodies render.
# Mirrors adk-tools/Dockerfile. Placed late so it never invalidates the apt
# build-cache layers above.
ENV INTERCONNECT_PDK_ROOT=/opt/pdks/interconnect_pdk \
    INTERPOSER_PDK_ROOT=/opt/pdks/interposer \
    PDK_ROOT=/opt/pdks/ihp-sg13g2

WORKDIR /workspace

# Default command: build everything
CMD ["bash", "-c", "\
    cd /workspace/extern/klayout && \
    ./build.sh -j$(nproc) -without-qtbinding && \
    cd /workspace && \
    mkdir -p build && cd build && \
    cmake .. -DKLAYOUT_BUILD_DIR=/workspace/extern/klayout/bin-release && \
    make -j$(nproc)"]
