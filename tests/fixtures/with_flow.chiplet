format_version: "1.0"

assembly:
  name: "Flow Test Assembly"
  description: "Assembly with flow pipeline for testing"
  units: "um"

technologies:
  sg13g2:
    description: "IHP SG13G2 130nm BiCMOS"
    dbu: 0.001

components:
  - id: interposer
    type: interposer
    technology: sg13g2
    dimensions: {width: 5000.0, height: 5000.0, thickness: 100.0}

  - id: die_0
    type: die
    technology: sg13g2
    dimensions: {width: 1000.0, height: 1000.0, thickness: 10.0}
    position: {x: 500.0, y: 500.0, z: 100.0}

flow:
  working_directory: /tmp/flow_test
  environment:
    PDK_ROOT: /opt/pdk
    DEBUG: "1"
  steps:
    - id: step_hello
      name: "Hello World"
      tool: /bin/echo
      args: ["hello", "${assembly.name}"]
      output_files: [hello.txt]

    - id: step_goodbye
      name: "Goodbye"
      tool: /bin/echo
      args: ["goodbye"]
      depends_on: [step_hello]
      input_files: [hello.txt]
