format_version: "1.0"
assembly:
  name: "Flip-chip render mode fixture"
  description: "Verifies auto-promotion to Detailed for flip-chip dies on parse"
  units: "um"
components:
  - id: interposer
    type: interposer
    anchor: bbox_center
    dimensions: {width: 1000, height: 1000, thickness: 13.83}
    position: {x: 500, y: 500, z: 0}
  - id: U_flip
    type: die
    anchor: gds_origin
    orientation: flip_chip
    dimensions: {width: 100, height: 100, thickness: 50}
    position: {x: 250, y: 250, z: 50}
  - id: U_faceup
    type: die
    anchor: gds_origin
    dimensions: {width: 100, height: 100, thickness: 50}
    position: {x: 750, y: 750, z: 50}
