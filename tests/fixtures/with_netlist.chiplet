format_version: "1.0"

assembly:
  name: "Netlist Test Assembly"
  description: "Assembly with netlist for testing"
  units: "um"

technologies:
  sg13g2:
    description: "IHP SG13G2 130nm BiCMOS"
    dbu: 0.001

components:
  - id: interposer
    type: interposer
    technology: sg13g2
    dimensions: {width: 5000.0, height: 5000.0, thickness: 100.0}

  - id: die_0
    type: die
    technology: sg13g2
    dimensions: {width: 1000.0, height: 1000.0, thickness: 10.0}
    position: {x: 500.0, y: 500.0, z: 100.0}

netlist:
  nets:
    - name: VDD
      class: power
      connections:
        - {component: interposer, pin: vdd_pad, layer: TopMetal2}
        - {component: die_0, pin: vdd, layer: TopMetal2}
    - name: GND
      class: ground
      connections:
        - {component: interposer, pin: gnd_pad, layer: TopMetal2}
        - {component: die_0, pin: vss, layer: TopMetal2}
    - name: SIG0
      class: signal
      connections:
        - {component: interposer, pin: sig0_pad, layer: TopMetal2}
        - {component: die_0, pin: data_out, layer: TopMetal2}
  external_netlist: test_netlist.csv
