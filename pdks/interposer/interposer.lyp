<?xml version='1.0' encoding='UTF-8'?>
<!--
 Interposer PDK - Derived from IHP SG13G2

 Contains only upper metal layers suitable for interposer routing:
 - Metal4 - First redistribution layer
 - Via4 - Via between Metal4 and Metal5
 - Metal5 - Second redistribution layer
 - TopVia1 - Via to thick metal
 - TopMetal1 - First thick metal
 - TopVia2 - Via to top metal
 - TopMetal2 - Top metal for bumps/pillars

 Colors: Cyan/Blue tones to distinguish from IHP green/yellow
 Layer numbers same as IHP for GDS compatibility.

 Note: Layer name standardization (pdk_name.layer_name) is handled
 internally when loading, not in this file.
-->
<layer-properties>
  <!-- Metal4 - Cyan -->
  <properties>
    <frame-color>#00bfff</frame-color>
    <fill-color>#00bfff</fill-color>
    <frame-brightness>0</frame-brightness>
    <fill-brightness>0</fill-brightness>
    <dither-pattern>C27</dither-pattern>
    <line-style>C1</line-style>
    <valid>true</valid>
    <visible>true</visible>
    <transparent>false</transparent>
    <width>1</width>
    <marked>false</marked>
    <animation>0</animation>
    <name>Metal4.drawing</name>
    <source>50/0</source>
  </properties>
  <properties>
    <frame-color>#00bfff</frame-color>
    <fill-color>#00bfff</fill-color>
