# Build directories
build/
build-*/
bin/
bin-*/

# Packaging / portable bundle artifacts (large, regenerated by scripts/build-portable.sh)
dist/
AppDir/
Testing/
*.AppImage

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake

# Qt
moc_*.cpp
ui_*.h
qrc_*.cpp
*.moc

# IDE
.idea/
.vscode/
*.pro.user
*.qbs.user

# Compiled files
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Chiplet cache (generated)
.chiplet-cache/
*.chiplet.cache

# Crash-recovery autosave (generated at runtime)
*.autosave.chiplet

# Session logs (timestamped, written in the invocation directory at runtime)
chiplet-studio_*.log

# Python bytecode. tests/ carries .py that get imported as modules, by the
# cross-reader check's own controls among others, and the tree had no rule
# for the __pycache__ that leaves behind.
__pycache__/
*.pyc

# What a local pytest run of tests/contracts/ leaves (CONTRIBUTING.md).
.venv/
.pytest_cache/
*.egg-info/

# OS
.DS_Store
Thumbs.db

